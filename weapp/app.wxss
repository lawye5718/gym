/* 全局样式：暗色玻璃拟态，Leo 冷色 / Linda 暖色由页面级 class 切换 */
page {
  background: #0b1020;
  color: #f1f5f9;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --safe-bottom: env(safe-area-inset-bottom);
}

.safe-bottom {
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.card {
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 32rpx;
  backdrop-filter: blur(20rpx);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.badge {
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.1);
}

.btn {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #6ea8ff, #7ef0c0);
  color: #0d1220;
  border: none;
}

.btn-gold {
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #1f2937;
  border: none;
}

.giant-btn {
  height: 112rpx;
  border-radius: 28rpx;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dim {
  opacity: 0.7;
}

.tiny {
  font-size: 22rpx;
}

.mono {
  font-variant-numeric: tabular-nums;
}
