.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.hi {
  font-size: 34rpx;
  font-weight: 900;
}
.tabs {
  display: flex;
  gap: 12rpx;
  margin: 18rpx 0;
}
.tab {
  padding: 12rpx 26rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.08);
}
.tab.on {
  background: linear-gradient(135deg, #6ea8ff, #7ef0c0);
  color: #0d1220;
  font-weight: 800;
}
.card {
  margin: 18rpx 0;
  padding: 22rpx;
}
.ta {
  width: 100%;
  height: 320rpx;
  margin: 14rpx 0;
  padding: 16rpx;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.35);
  font-size: 22rpx;
  box-sizing: border-box;
}
.name {
  font-size: 30rpx;
  font-weight: 800;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
}
.avatar.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.1);
}
.ops {
  margin-top: 16rpx;
}
.ops .btn {
  margin-right: 12rpx;
}
.msg {
  margin: 18rpx 0;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(110, 168, 255, 0.15);
}
.tips {
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}
