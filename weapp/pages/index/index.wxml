<view class="page safe-bottom">

  <!-- 顶栏：身份 / 场馆 / 入口 -->
  <view class="topbar">
    <view class="row">
      <text class="who">{{profile ? profile.name : user}}</text>
      <text class="badge">{{isAdmin ? '管理员' : '成员'}}</text>
    </view>
    <view class="row">
      <view
        wx:for="{{venues}}"
        wx:key="id"
        class="venue {{venueMode === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="switchVenue"
      >{{item.name}}</view>
    </view>
    <view class="row">
      <view class="btn tiny" bindtap="goMembers">成员</view>
      <view class="btn tiny" bindtap="goAudit">审计</view>
      <view class="btn tiny" bindtap="goSettings">设置</view>
    </view>
  </view>

  <!-- 当日主题 -->
  <view class="daybar">
    <text class="dayname">Day {{day}} · {{dayName}}</text>
    <text class="tiny dim">{{dayFocus}}</text>
  </view>

  <!-- 迷你点阵进度条（V2.9.1） -->
  <view class="stepper" wx:if="{{deck.length > 1}}">
    <view
      wx:for="{{deck}}"
      wx:key="index"
      class="dot {{cardIdx === index ? 'cur' : ''}} {{item.type === 'exercise' && cardCompletion[index - 1] === 'done' ? 'done' : ''}} {{item.type !== 'exercise' ? 'aux' : ''}}"
      data-idx="{{index}}"
      bindtap="goCard"
    />
  </view>

  <view class="stage" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">

    <!-- ③ 有氧 / 静息日面板 -->
    <view wx:if="{{!hasPlan}}" class="card">
      <!-- Zone 2 -->
      <block wx:if="{{cardioType === 'zone2'}}">
        <text class="hi">❤️ Zone 2 主动恢复</text>
        <text class="tiny dim">心率 110–130 bpm，线粒体修复与排酸</text>
        <view wx:if="{{cardioSaved && cardioSaved.completed}}" class="donebadge">
          ✅ 今日已打卡 · {{cardioSaved.durationMinutes}} 分钟 / 平均 {{cardioSaved.avgHeartRate}} bpm
        </view>
        <view class="field">
          <text class="tiny dim">持续时长（分钟）</text>
          <input class="ipt" type="number" value="{{cardio.duration}}" data-field="duration" bindinput="onCardioInput" />
        </view>
        <view class="field">
          <text class="tiny dim">平均心率（目标 110–130）</text>
          <input class="ipt" type="number" value="{{cardio.avgHr}}" data-field="avgHr" bindinput="onCardioInput" />
          <text class="tiny {{cardio.avgHr >= 110 && cardio.avgHr <= 130 ? 'ok' : 'warn'}}">
            {{cardio.avgHr >= 110 && cardio.avgHr <= 130 ? '✓ 处于 Zone 2 区间' : '⚠ 偏离目标区间'}}
          </text>
        </view>
        <view class="tagrow">
          <view
            wx:for="{{cardioTags}}"
            wx:key="*this"
            class="tag {{cardio.tags.indexOf(item) >= 0 ? 'on' : ''}}"
            data-tag="{{item}}"
            bindtap="toggleCardioTag"
          >{{item}}</view>
        </view>
        <view class="giant-btn btn-primary" bindtap="saveCardio">保存今日有氧</view>
      </block>

      <!-- 挪威 4x4 HIIT -->
      <block wx:elif="{{cardioType === 'hiit'}}">
        <text class="hi">🔥 挪威 4×4 HIIT</text>
        <text class="tiny dim">冲刺 4 分钟 → 恢复 3 分钟 × 4 轮，峰值心率冲击</text>
        <view wx:if="{{cardio.hiitRunning}}" class="hiitbox">
          <text class="bignum">第 {{cardio.round}}/4 轮 · {{cardio.phase === 'sprint' ? '冲刺' : '恢复'}}</text>
          <text class="hugenum">{{cardio.left}}s</text>
          <view class="btn tiny" bindtap="stopHiit">结束计时</view>
        </view>
        <view wx:else class="btn btn-primary" bindtap="startHiit">开始 4×4 计时</view>
        <view class="tagrow">
          <view
            wx:for="{{cardioTags}}"
            wx:key="*this"
            class="tag {{cardio.tags.indexOf(item) >= 0 ? 'on' : ''}}"
            data-tag="{{item}}"
            bindtap="toggleCardioTag"
          >{{item}}</view>
        </view>
        <view class="giant-btn btn-primary" bindtap="saveCardio">保存今日 HIIT</view>
      </block>

      <!-- 静息日 -->
      <block wx:else>
        <text class="hi">🧘 中枢神经被动静息</text>
        <text class="tiny dim">完全不负重，筋膜放松与温泉休养</text>
        <view wx:if="{{cardioSaved && cardioSaved.completed}}" class="donebadge">✅ 今日已打卡</view>
        <view class="tagrow">
          <view
            wx:for="{{cardioTags}}"
            wx:key="*this"
            class="tag {{cardio.tags.indexOf(item) >= 0 ? 'on' : ''}}"
            data-tag="{{item}}"
            bindtap="toggleCardioTag"
          >{{item}}</view>
        </view>
        <view class="giant-btn btn-primary" bindtap="saveCardio">保存静息打卡</view>
      </block>
    </view>

    <!-- ① 欢迎卡 -->
    <view wx:elif="{{deck[cardIdx].type === 'welcome'}}" class="card welcome">
      <text class="hi">今天也要稳稳进步 💪</text>
      <text class="tiny dim">Day {{day}} · {{dayName}}</text>
      <text class="tiny dim">{{dayFocus}}</text>
      <text class="tiny dim">ACSM 2026：RIR ≤ 2，离心 2 秒制动，底端停顿 1 秒</text>
      <view class="giant-btn btn-primary" data-d="next" bindtap="flip">开始训练 ➜</view>
    </view>

    <!-- ② 动作卡 -->
    <view wx:elif="{{deck[cardIdx].type === 'exercise'}}" class="card exercise">
      <view class="row between">
        <text class="badge">{{cardIdx}}/{{deck.length - 2}} · {{currentExercise.order}}</text>
        <view class="row">
          <view class="btn tiny" bindtap="openCue">📖 要领</view>
          <view class="btn tiny" bindtap="openSettings">⚙️ 设置</view>
          <view class="btn tiny" bindtap="toggleTagPanel">🏷️ {{tags.length ? '(' + tags.length + ')' : '标签'}}</view>
        </view>
      </view>

      <!-- 体感标签浮层 -->
      <view wx:if="{{showTags}}" class="tagpanel">
        <view
          wx:for="{{['⚡1.5s减速停(RIR2)','🛑底部停1秒极稳','🔥末组双起单下','🧤死手模式零抓握']}}"
          wx:key="*this"
          class="tag {{tags.indexOf(item) >= 0 ? 'on' : ''}}"
          data-tag="{{item}}"
          bindtap="tapTag"
        >{{item}}</view>
      </view>

      <text class="title">{{activeVariant.name}}</text>
      <view class="row between">
        <text class="tiny dim">{{activeVariant.machineCode}}</text>
        <text wx:if="{{plateHint}}" class="tiny gold">(单边 {{plateHint}})</text>
      </view>
      <view class="row"><text class="tiny dim">💺 {{activeVariant.defaultSeatNote}}</text></view>

      <view wx:if="{{banner && banner.type === 'upgrade_ready'}}" class="banner">
        <text class="tiny">{{banner.title}}</text>
        <view class="row">
          <view class="btn btn-gold tiny" data-decision="accepted" bindtap="ackUpgrade">确认升重</view>
          <view class="btn tiny" data-decision="dismissed" bindtap="ackUpgrade">暂不</view>
        </view>
      </view>

      <!-- 组列表 -->
      <scroll-view scroll-y class="setlist">
        <view wx:for="{{sets}}" wx:key="setNo" class="setrow {{item.completed ? 'done' : ''}}">
          <text class="setno">#{{item.setNo || index + 1}}</text>
          <input class="num" type="digit" value="{{item.weight}}" data-idx="{{index}}" bindblur="onWeightChange" />
          <text class="unit">kg</text>
          <input class="num" type="number" value="{{item.reps}}" data-idx="{{index}}" bindblur="onRepsChange" />
          <text class="unit">次</text>
          <view class="check {{item.completed ? 'on' : ''}}" data-idx="{{index}}" bindtap="toggleSetDone">✓</view>
        </view>
      </scroll-view>

      <!-- 巨型休息条 -->
      <view class="restbar">
        <view wx:if="{{status === 'idle'}}" class="row between">
          <view class="giant-btn btn-primary flex1" bindtap="startRest">完成本组并休息 {{restTotal}}s</view>
          <view class="btn tiny" bindtap="undoLastSet">撤销</view>
        </view>
        <view wx:elif="{{status === 'counting'}}" class="row between">
          <text class="mono big">{{secondsLeft}}s</text>
          <view class="btn tiny" bindtap="add15s">+15s</view>
          <view class="btn tiny" bindtap="stopAlarmAndAdvance">跳过</view>
        </view>
        <view wx:else class="ringing">
          <text class="big">⏰ 休息时间到！</text>
          <text class="tiny">点击任意处停止响铃并继续</text>
        </view>
      </view>
    </view>

    <!-- 当日清算卡 -->
    <view wx:elif="{{deck[cardIdx].type === 'summary'}}" class="card summary">
      <text class="hi">🧾 当日清算</text>
      <view class="statrow">
        <view class="stat"><text class="bignum">{{todayStats.done}}/{{todayStats.total}}</text><text class="tiny dim">已完成组数</text></view>
        <view class="stat"><text class="bignum">{{todayStats.volume}}</text><text class="tiny dim">总容量 kg</text></view>
      </view>
      <scroll-view scroll-y class="setlist">
        <view wx:for="{{flatExercises}}" wx:key="id" class="flatrow">
          <text class="tiny">{{item.activeVariant.name}}</text>
          <text class="tiny dim">{{item.activeVariant.sets || item.prescription.sets}} 组</text>
        </view>
      </scroll-view>
      <view class="giant-btn btn-primary" bindtap="finishWorkout">完成训练，查看总结 ➜</view>
      <view class="btn tiny" bindtap="restart">返回首卡</view>
    </view>

    <!-- 完赛卡 -->
    <view wx:else class="card finale">
      <text class="hi">🎉 今日训练完成</text>
      <text class="tiny dim">完成 {{todayStats.done}} / {{todayStats.total}} 组 · 总容量 {{todayStats.volume}} kg</text>
      <view class="giant-btn btn-primary" bindtap="restart">开启下一轮 ➜</view>
    </view>
  </view>

  <!-- ① 动作要领浮层 -->
  <view wx:if="{{showCue}}" class="mask" bindtap="closeCue">
    <view class="cuecard" catchtap="">
      <view class="row between">
        <view class="row">
          <view class="btn tiny" data-d="-0.25" bindtap="zoomCue">－</view>
          <text class="tiny">{{cueScale * 100}}%</text>
          <view class="btn tiny" data-d="0.25" bindtap="zoomCue">＋</view>
        </view>
        <text class="tiny dim">点击空白关闭</text>
      </view>
      <scroll-view scroll-y class="cuebody">
        <view style="transform: scale({{cueScale}}); transform-origin: top center;">
          <text class="title">{{activeVariant.name}}</text>
          <text class="tiny dim">{{activeVariant.machineCode}} · {{currentExercise.prescription.sets}} 组 × {{currentExercise.prescription.repRange[0]}}–{{currentExercise.prescription.repRange[1]}} 次</text>
          <view class="cuebox rose">
            <text class="tiny">🔥 向心 {{currentExercise.tempoGuide.concentric.time}}</text>
            <text class="tiny dim">{{currentExercise.tempoGuide.concentric.cue}}</text>
          </view>
          <view class="cuebox sky">
            <text class="tiny">❄️ 离心 {{currentExercise.tempoGuide.eccentric.time}}</text>
            <text class="tiny dim">{{currentExercise.tempoGuide.eccentric.cue}}</text>
          </view>
          <view class="cuebox amber">
            <text class="tiny">⏱️ 底部停顿 {{currentExercise.tempoGuide.bottomPause.time}}</text>
            <text class="tiny dim">{{currentExercise.tempoGuide.bottomPause.cue}}</text>
          </view>
          <view wx:if="{{currentExercise.tempoGuide.overloadCue}}" class="cuebox indigo">
            <text class="tiny">💡 超负荷要点</text>
            <text class="tiny dim">{{currentExercise.tempoGuide.overloadCue}}</text>
          </view>
          <view wx:for="{{currentExercise.media.keyPointsOverlay}}" wx:key="*this" class="kp">
            <text class="tiny">{{index + 1}}. {{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ② 器械设置卡 -->
  <view wx:if="{{showSettings}}" class="mask" bindtap="closeSettings">
    <view class="setcard" catchtap="">
      <view class="row between">
        <text class="hi">⚙️ 器械设置</text>
        <text class="tiny dim">{{activeVariant.name}}</text>
      </view>
      <scroll-view scroll-y class="setbody">
        <view class="field">
          <text class="tiny dim">基准重量 (kg)</text>
          <input class="ipt" type="digit" value="{{settingsForm.weight}}" data-field="weight" bindinput="onSettingInput" />
        </view>
        <view class="field">
          <text class="tiny dim">总组数</text>
          <input class="ipt" type="number" value="{{settingsForm.sets}}" data-field="sets" bindinput="onSettingInput" />
        </view>
        <view class="field">
          <text class="tiny dim">每组默认次数（逗号分隔，如 12,10,8）</text>
          <input class="ipt" value="{{settingsForm.repsText}}" data-field="repsText" bindinput="onSettingInput" />
        </view>
        <view class="field">
          <text class="tiny dim">组间休息（秒）</text>
          <input class="ipt" type="number" value="{{settingsForm.restSeconds}}" data-field="restSeconds" bindinput="onSettingInput" />
        </view>
        <view class="field">
          <text class="tiny dim">💺 机位 / 孔位记忆</text>
          <input class="ipt" value="{{settingsForm.seatNote}}" data-field="seatNote" bindinput="onSettingInput" placeholder="如 座椅3档" />
        </view>
      </scroll-view>
      <view class="row">
        <view class="btn btn-primary flex1" bindtap="saveSettings">保存设置</view>
        <view class="btn" bindtap="resetSettings">恢复标准</view>
      </view>
    </view>
  </view>

  <!-- 响铃全屏打断遮罩 -->
  <view wx:if="{{status === 'ringing'}}" class="alarm-mask" bindtap="stopAlarmAndAdvance">
    <text class="big">⏰</text>
    <text class="tiny">点击任意位置停止并继续</text>
  </view>

  <!-- 未授权 -->
  <view wx:if="{{!authorized}}" class="locked">
    <text class="hi">🔒 尚未获得使用权限</text>
    <text class="tiny dim">请联系管理员 Leo 激活，或前往「成员」页输入邀请码</text>
    <view class="btn btn-primary" bindtap="goMembers">前往激活</view>
  </view>
</view>
