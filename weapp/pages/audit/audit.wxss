.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.hi {
  font-size: 36rpx;
  font-weight: 900;
}
.card {
  margin: 18rpx 0;
  padding: 22rpx;
}
.name {
  font-size: 28rpx;
  font-weight: 700;
}
.num {
  font-size: 26rpx;
  font-weight: 900;
}
.num.ok {
  color: #6ee7b7;
}
.num.no {
  color: #fbbf24;
}
.bar {
  height: 14rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.12);
  margin: 14rpx 0 8rpx;
  overflow: hidden;
}
.fill {
  height: 100%;
  background: linear-gradient(90deg, #fbbf24, #f59e0b);
}
.fill.ok {
  background: linear-gradient(90deg, #34d399, #10b981);
}
.tips {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.06);
}
